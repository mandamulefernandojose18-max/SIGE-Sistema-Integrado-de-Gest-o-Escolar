{
  "name": "sige-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SIGE — Sistema Integrado de Gestão Escolar (Django REST Framework + Vanilla Frontend SPA)",
  "scripts": {
    "dev:backend": "cd backend && python manage.py runserver 0.0.0.0:8000",
    "dev:frontend": "npm --prefix frontend start",
    "test:backend": "cd backend && pytest",
    "migrate:backend": "cd backend && python manage.py migrate",
    "seed:backend": "cd backend && python manage.py seed",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "sige",
    "saas",
    "multi-tenant",
    "escola",
    "gestao-escolar",
    "django",
    "django-rest-framework",
    "postgresql",
    "pwa"
  ],
  "author": "SIGE Core Engineering Team",
  "license": "MIT"
}
