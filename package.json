{
  "name": "sige-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SIGE — Sistema Integrado de Gestão Escolar (Monorepo Backend & Frontend)",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "build:backend": "npm --prefix backend run build",
    "test:backend": "npm --prefix backend test",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "sige",
    "saas",
    "multi-tenant",
    "escola",
    "gestao-escolar",
    "prisma",
    "express",
    "typescript"
  ],
  "author": "SIGE Core Engineering Team",
  "license": "MIT"
}
