{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://alexandria-wesley-jury-chances.trycloudflare.com/api/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "https://alexandria-wesley-jury-chances.trycloudflare.com/health/$1"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/:perfil(saas|admin|direcao|pedagogico|secretaria|professor|aluno|encarregado|financeiro)/:vista?",
      "destination": "/painel.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
