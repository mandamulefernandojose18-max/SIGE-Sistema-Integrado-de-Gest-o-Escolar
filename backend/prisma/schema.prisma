generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Planos do SaaS (Mensal, Trimestral, Semestral, Anual)
model Plano {
  id               String             @id @default(uuid())
  nome             String             @unique // MENSAL, TRIMESTRAL, SEMESTRAL, ANUAL
  descricao        String?
  preco            Float
  duracao_dias     Int
  max_alunos       Int                @default(500)
  max_professores  Int                @default(50)
  ativo            Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  escolas          Escola[]
  assinaturas      AssinaturaEscola[]
}

// Tenant / Escola
model Escola {
  id                   String             @id @default(uuid())
  nome                 String
  nif_cnpj             String             @unique
  endereco             String?
  telefone             String?
  email                String             @unique
  logo_url             String?
  status               String             @default("ATIVA") // ATIVA, PENDENTE, EXPIRADA, SUSPENSA
  ano_letivo_ativo     String             @default("2026")
  trimestre_ativo      String             @default("1_TRIMESTRE") // 1_TRIMESTRE, 2_TRIMESTRE, 3_TRIMESTRE
  plano_id             String?
  plano                Plano?             @relation(fields: [plano_id], references: [id])
  data_adesao          DateTime           @default(now())
  
  // Dados Oficiais de Moçambique
  provincia            String?            @default("Maputo")
  distrito             String?            @default("Cidade de Maputo")
  director_nome        String?            @default("Prof. Dr. António Costa")
  director_carreira    String?            @default("Professor Doutor")
  dap_nome             String?            @default("Prof. João Baptista")
  chefe_secretaria_nome String?           @default("Dra. Maria Eunice")
  usar_emblema_nacional Boolean           @default(true)
  codigo_escola        String?
  logo_base64          String?
  bloqueada_manualmente Boolean           @default(false)
  permitir_visualizacao_notas Boolean       @default(true)

  // Inscrições e Matrículas Online
  inscricoes_abertas   Boolean?           @default(false)
  inscricoes_inicio    DateTime?
  inscricoes_fim       DateTime?
  inscricoes_fase2_fim DateTime?
  inscricoes_fase2_multa_pct Float?       @default(0)
  inscricoes_fase3_fim DateTime?
  inscricoes_fase3_multa_pct Float?       @default(0)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  assinaturas          AssinaturaEscola[]
  usuarios             Usuario[]
  logs_acesso          LogAcesso[]
  turmas               Turma[]
  alunos               Aluno[]
  professores          Professor[]
  disciplinas          Disciplina[]
  alocacoes            ProfessorDisciplinaTurma[]
  notas                Nota[]
  pautas               Pauta[]
  certificados         Certificado[]
  pagamentos           Pagamento[]
  logs_impressao       LogImpressao[]
  permissoes_edicao    PermissaoEdicaoNotas[]
  documentos_salvos    DocumentoSalvo[]
  materiais_escolares  MaterialEscolar[]
}

// Histórico e Vigência de Assinaturas das Escolas
model AssinaturaEscola {
  id               String   @id @default(uuid())
  escola_id        String
  escola           Escola   @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  plano_id         String
  plano            Plano    @relation(fields: [plano_id], references: [id])
  data_inicio      DateTime @default(now())
  data_fim         DateTime
  valor            Float
  status           String   @default("ATIVA") // ATIVA, PENDENTE, EXPIRADA, SUSPENSA
  metodo_pagamento String   @default("TRANSFERENCIA")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([escola_id])
  @@index([status])
}

// Usuários do Sistema com RBAC
model Usuario {
  id           String        @id @default(uuid())
  escola_id    String?       // Nulo para SuperAdmin
  escola       Escola?       @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  nome         String
  email        String        @unique
  senha_hash   String
  role         String        @default("ADMIN_ESCOLA") // SUPERADMIN, ADMIN_ESCOLA, DIRECTOR_ESCOLA, DAP, CHEFE_SECRETARIA, PROFESSOR, ALUNO, FINANCEIRO
  ativo        Boolean       @default(true)
  telefone     String?
  avatar_url   String?
  
  aluno_id     String?       @unique
  aluno        Aluno?        @relation("UsuarioAluno", fields: [aluno_id], references: [id], onDelete: SetNull)
  
  professor_id String?       @unique
  professor    Professor?    @relation("UsuarioProfessor", fields: [professor_id], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  refresh_tokens RefreshToken[]
  logs_acesso    LogAcesso[]

  @@index([escola_id])
  @@index([role])
}

model RefreshToken {
  id         String   @id @default(uuid())
  usuario_id String
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  token      String   @unique
  expires_at DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([usuario_id])
}

model LogAcesso {
  id         String   @id @default(uuid())
  escola_id  String?
  escola     Escola?  @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  usuario_id String?
  usuario    Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  ip         String   @default("127.0.0.1")
  user_agent String?
  tipo       String   // LOGIN_SUCESSO, LOGIN_FALHA, ACESSO_BLOQUEADO_EXPIRADO
  createdAt  DateTime @default(now())

  @@index([escola_id])
  @@index([tipo])
  @@index([createdAt])
}

// Turmas
model Turma {
  id                 String   @id @default(uuid())
  escola_id          String
  escola             Escola   @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  nome               String   // Ex: 10ª Classe A, 9º Ano B
  grau_ano           String   // Ex: 10ª Classe
  turno              String   @default("MANHA") // MANHA, TARDE, NOITE
  sala               String?
  ano_letivo         String   @default("2026")
  area               String?  @default("Geral")
  
  director_turma_id  String?
  director_turma     Professor? @relation("TurmasDirectorTurma", fields: [director_turma_id], references: [id], onDelete: SetNull)
  director_classe_id String?
  director_classe    Professor? @relation("TurmasDirectorClasse", fields: [director_classe_id], references: [id], onDelete: SetNull)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  alunos      Aluno[]
  alocacoes   ProfessorDisciplinaTurma[]
  notas       Nota[]
  pautas      Pauta[]

  @@index([escola_id])
}

// Alunos
model Aluno {
  id                  String        @id @default(uuid())
  escola_id           String
  escola              Escola        @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  turma_id            String?
  turma               Turma?        @relation(fields: [turma_id], references: [id], onDelete: SetNull)
  matricula           String        @unique
  nome                String
  apelido             String?
  data_nascimento     DateTime
  genero              String        // M, F
  tipo_documento      String?       @default("Bilhete de Identidade")
  numero_documento    String?
  nuit                String?
  nacionalidade       String?       @default("Moçambicana")
  provincia           String?       @default("Maputo")
  distrito            String?       @default("Cidade de Maputo")
  pai                 String?
  mae                 String?
  nome_responsavel    String?
  contato_responsavel String?
  email_responsavel   String?
  status              String        @default("ATIVO") // ATIVO, INATIVO, TRANSFERIDO, EVADIDO
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  usuario             Usuario?      @relation("UsuarioAluno")
  notas               Nota[]
  certificados        Certificado[]
  pagamentos          Pagamento[]

  @@index([escola_id])
  @@index([turma_id])
  @@index([status])
}

// Professores
model Professor {
  id                     String                     @id @default(uuid())
  escola_id              String
  escola                 Escola                     @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  nome                   String
  apelido                String?
  genero                 String?                    @default("M")
  email                  String
  telefone               String?
  tipo_documento         String?                    @default("Bilhete de Identidade")
  numero_documento       String?
  nuit                   String?
  nacionalidade          String?                    @default("Moçambicana")
  provincia              String?                    @default("Maputo")
  distrito               String?                    @default("Cidade de Maputo")
  carreira               String?                    @default("DN1") // DN4, DN3, DN2, DN1, Especialista de Educação, Mestre, Professor Doutor
  especialidade          String                     // Ex: Matemática, Física, Português
  carga_horaria_semanal  Int                        @default(20)
  ativo                  Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  usuario                Usuario?                   @relation("UsuarioProfessor")
  alocacoes              ProfessorDisciplinaTurma[]
  permissoes_edicao      PermissaoEdicaoNotas[]
  turmasDirectorTurma    Turma[]                    @relation("TurmasDirectorTurma")
  turmasDirectorClasse   Turma[]                    @relation("TurmasDirectorClasse")

  @@index([escola_id])
}

// Disciplinas
model Disciplina {
  id            String                     @id @default(uuid())
  escola_id     String
  escola        Escola                     @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  nome          String                     // Ex: Matemática, Língua Portuguesa
  codigo        String                     // Ex: MAT-10
  classe        String?                    @default("10ª Classe") // Ex: 7ª Classe, 8ª Classe, 9ª Classe, 10ª Classe, 11ª Classe, 12ª Classe
  area          String?                    @default("Geral")      // Ex: Geral, Letras, Ciências
  carga_horaria Int                        @default(60)
  ano_letivo    String                     @default("2026")
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  alocacoes     ProfessorDisciplinaTurma[]
  notas         Nota[]
  materiais     MaterialEscolar[]

  @@index([escola_id])
}

// Alocação Professor x Disciplina x Turma
model ProfessorDisciplinaTurma {
  id            String     @id @default(uuid())
  escola_id     String
  escola        Escola     @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  professor_id  String
  professor     Professor  @relation(fields: [professor_id], references: [id], onDelete: Cascade)
  disciplina_id String
  disciplina    Disciplina @relation(fields: [disciplina_id], references: [id], onDelete: Cascade)
  turma_id      String
  turma         Turma      @relation(fields: [turma_id], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@index([escola_id])
  @@index([professor_id])
  @@index([disciplina_id])
  @@index([turma_id])
}

// Notas e Avaliações Trimestrais Oficiais
model Nota {
  id                   String     @id @default(uuid())
  escola_id            String
  escola               Escola     @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  aluno_id             String
  aluno                Aluno      @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  disciplina_id        String
  disciplina           Disciplina @relation(fields: [disciplina_id], references: [id], onDelete: Cascade)
  turma_id             String
  turma                Turma      @relation(fields: [turma_id], references: [id], onDelete: Cascade)
  periodo              String     // 1_TRIMESTRE, 2_TRIMESTRE, 3_TRIMESTRE

  teste1               Float?     @default(0)
  teste2               Float?     @default(0)
  teste3               Float?
  teste4               Float?
  trabalho             Float?     @default(0)
  avaliacao_trimestral Float?     @default(0)
  media_final          Float      @default(0) // Arredondada
  
  faltas               Int        @default(0)
  anotacao             String?    // D, T, VT, F, AM, PPF, PDF
  comportamento        String?    @default("S") // NS, S, B, MB, E
  resultado            String?    @default("Aprovado") // Aprovado, Reprovado

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([escola_id])
  @@index([aluno_id])
  @@index([disciplina_id])
  @@index([turma_id])
}

// Permissão de Edição de Notas em Trimestres Findos
model PermissaoEdicaoNotas {
  id             String    @id @default(uuid())
  escola_id      String
  escola         Escola    @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  professor_id   String
  professor      Professor @relation(fields: [professor_id], references: [id], onDelete: Cascade)
  turma_id       String
  disciplina_id  String
  periodo        String    // 1_TRIMESTRE, 2_TRIMESTRE
  autorizado_por String
  motivo         String?
  ativa          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([escola_id])
  @@index([professor_id])
}

// Pautas e Consolidação de Turmas
model Pauta {
  id              String    @id @default(uuid())
  escola_id       String
  escola          Escola    @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  turma_id        String
  turma           Turma     @relation(fields: [turma_id], references: [id], onDelete: Cascade)
  ano_letivo      String    @default("2026")
  periodo         String    // 1_TRIMESTRE, 2_TRIMESTRE, 3_TRIMESTRE, ANUAL
  status          String    @default("ABERTA") // ABERTA, EM_CONSOLIDACAO, FECHADA
  data_fechamento DateTime?
  homologado_por  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([escola_id])
  @@index([turma_id])
}

// Certificados e Comprovativos com QR Code
model Certificado {
  id                   String   @id @default(uuid())
  escola_id            String
  escola               Escola   @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  aluno_id             String
  aluno                Aluno    @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  tipo                 String   // CONCLUSAO, TRANSFERENCIA, DECLARACAO, MATRICULA
  codigo_autenticidade String   @unique
  qrcode_data          String
  emitido_em           DateTime @default(now())
  emitido_por          String?
  createdAt            DateTime @default(now())

  @@index([escola_id])
  @@index([aluno_id])
  @@index([codigo_autenticidade])
}

// Gestão Financeira de Pagamentos de Alunos (Emolumentos e Propinas em MZN)
model Pagamento {
  id               String    @id @default(uuid())
  escola_id        String
  escola           Escola    @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  aluno_id         String
  aluno            Aluno     @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  descricao        String    // Ex: Mensalidade de Março, Taxa de Matrícula
  mes_referencia   String    // Ex: 2026-03
  valor            Float
  valor_pago       Float     @default(0)
  status           String    @default("PENDENTE") // PENDENTE, PAGO, ATRASADO, CANCELADO
  data_vencimento  DateTime
  data_pagamento   DateTime?
  metodo_pagamento String?   // MPESA, EMOLA, POS, TRANSFERENCIA, NUMERARIO
  recibo_numero    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([escola_id])
  @@index([aluno_id])
  @@index([status])
}

// Auditoria de Impressões e Documentos
model LogImpressao {
  id             String   @id @default(uuid())
  escola_id      String
  escola         Escola   @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  usuario_id     String?
  tipo_documento String   // BOLETIM, DECLARACAO, CERTIFICADO, PAUTA, CADERNETA, RECIBO, FICHA_ALUNO, ACTA
  descricao      String
  conteudo_json  String?
  data_emissao   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([escola_id])
  @@index([tipo_documento])
}

// Armazenamento Permanente e Auditoria de Documentos Gravados em JSON
model DocumentoSalvo {
  id             String   @id @default(uuid())
  escola_id      String
  escola         Escola   @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  usuario_id     String?
  aluno_id       String?
  turma_id       String?
  tipo_documento String   // BOLETIM, DECLARACAO, CERTIFICADO, PAUTA, ACTA, CADERNETA
  titulo         String
  ano_letivo     String   @default("2026")
  dados_json     String
  hash_md5       String?
  criado_em      DateTime @default(now())

  @@index([escola_id])
  @@index([tipo_documento])
  @@index([aluno_id])
  @@index([turma_id])
}

// Material Escolar e Recursos Didáticos por Classe (Livros, Manuais, Fichas de Exercícios)
model MaterialEscolar {
  id              String      @id @default(uuid())
  escola_id       String
  escola          Escola      @relation(fields: [escola_id], references: [id], onDelete: Cascade)
  disciplina_id   String?
  disciplina      Disciplina? @relation(fields: [disciplina_id], references: [id], onDelete: SetNull)
  classe          String      // ex: "1ª Classe", "2ª Classe", ..., "10ª Classe", "12ª Classe"
  titulo          String
  descricao       String?
  nome_arquivo    String      @default("material.pdf")
  extensao        String      @default("pdf")
  tamanho_bytes   Int         @default(0)
  conteudo_base64 String?     // Armazenamento em Base64 Data URL para download e visualização direta
  tipo_mime       String?     // application/pdf, etc.
  arquivo_url     String?     // Ou link externo
  tipo            String?     @default("MANUAL") // MANUAL, FICHA, LIVRO, EXERCICIOS, GUIA, OUTRO
  publicado_por   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([escola_id])
  @@index([classe])
}

